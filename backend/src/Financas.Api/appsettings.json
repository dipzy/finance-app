{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} | pedido={RequestId} utilizador={Utilizador} {SourceContext}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Firebase": {
    "ProjectId": "financas-app-2ffc6"
  },
  "Relogio": {
    "FusoHorario": "Europe/Lisbon"
  },
  "Cors": {
    "Origens": [
      "https://financas-app-2ffc6.web.app",
      "https://financas-app-2ffc6.firebaseapp.com",
      "http://localhost:8081",
      "http://localhost:8082",
      "http://localhost:19006"
    ]
  },
  "LimitesPedidos": {
    "PorMinuto": 120,
    "PesadosPorMinuto": 10
  }
}
