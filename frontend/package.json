{
  "name": "financas-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "deploy:web": "jest --ci && expo export -p web --clear && npx firebase-tools deploy --only hosting",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "test": "jest",
    "publicar:app": "jest --ci && npx eas-cli update --channel preview --platform android --auto",
    "gerar:api": "node scripts/gerar-api-types.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.29.0",
    "expo": "^57.0.27",
    "expo-asset": "~57.0.19",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.10",
    "@playwright/test": "^1.64.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.4",
    "expo-modules-core": "~57.0.21",
    "jest": "~30.5.2",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
