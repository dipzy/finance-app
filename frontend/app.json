{
  "expo": {
    "name": "Finanças",
    "slug": "financas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financasapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070B14",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dipzy.financas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monocromo.png",
        "backgroundColor": "#070B14"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#070B14"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070B14"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notificacao.png",
          "color": "#00E5FF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que as Finanças usem o Face ID para desbloquear a app."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "atalho_novo": {
              "foregroundImage": "./assets/images/atalhos/novo.png",
              "backgroundColor": "#0B1222"
            },
            "atalho_lista": {
              "foregroundImage": "./assets/images/atalhos/lista.png",
              "backgroundColor": "#0B1222"
            },
            "atalho_resumo": {
              "foregroundImage": "./assets/images/atalhos/resumo.png",
              "backgroundColor": "#0B1222"
            }
          }
        }
      ],
      "@sentry/react-native",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e944208-9f60-429c-9e4a-b21b6b884c96"
      }
    },
    "owner": "dipzy",
    "updates": {
      "url": "https://u.expo.dev/9e944208-9f60-429c-9e4a-b21b6b884c96",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
