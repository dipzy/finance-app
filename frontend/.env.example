# Copiar para .env e preencher com o "firebaseConfig" da consola Firebase:
# Definições do projeto > Geral > As tuas apps > App Web
#
# Estes valores identificam o projeto mas não são secretos (vão dentro da app);
# quem protege os dados são as regras em firestore.rules
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Endereço da API (.NET, pasta backend/). Vazio: http://localhost:5080 (a API a correr neste
# computador; no emulador Android usar http://10.0.2.2:5080, num telemóvel o IP do computador).
# Produção (Render): o URL do serviço, ex.: https://financas-api.onrender.com
EXPO_PUBLIC_API_URL=

# Monitorização de erros (Sentry, https://sentry.io). Vazio: desligado (a app funciona igual).
# O DSN é o endereço de envio do projeto "React Native" no Sentry (Settings > Client Keys); não é secreto.
# Só vai para o Sentry o que correu mal (erros da app e falhas 5xx/rede da API) e o id do utilizador:
# nunca emails, nomes, valores nem textos das despesas. Só envia em builds de produção (não em __DEV__).
# Código nativo: chega à app com um APK novo (npx eas-cli build -p android --profile preview).
EXPO_PUBLIC_SENTRY_DSN=
